# GPUHarbor starts closed and cannot create/start billable resources by default.
RUNPOD_ALLOW_BILLABLE_ACTIONS=false
RUNPOD_API_KEY=replace-with-a-random-secret
CONTROL_TOKEN=replace-with-a-different-random-secret
MODEL_ACCESS_TOKEN=replace-with-a-model-only-random-secret
RUNTIME_GATEWAY_TOKEN=replace-with-a-fourth-random-secret
GPUHARBOR_ADMIN_USERNAME=admin
GPUHARBOR_ADMIN_PASSWORD=replace-with-a-long-random-password
GPUHARBOR_SESSION_SECRET=replace-with-a-fifth-random-secret
GPUHARBOR_COOKIE_SECURE=false
# Addresses exactly as typed in the browser (IP or hostname). Extend with ./scripts/add-host.
GPUHARBOR_TRUSTED_HOSTS=localhost,127.0.0.1
GPUHARBOR_LOGIN_MAX_ATTEMPTS=5
GPUHARBOR_LOGIN_WINDOW_SECONDS=300
GPUHARBOR_MAX_REQUEST_MB=20

# Opt-in: seed the default for the update-notification toggle in the web UI.
GPUHARBOR_UPDATE_CHECK=false

RUNPOD_API_BASE=https://api.runpod.io/v2
RUNPOD_POD_NAME=gpuharbor-model
RUNPOD_DATACENTER_IDS=EU-SE-1,CA-MTL-1
RUNPOD_CONTAINER_DISK_GB=20
RUNPOD_IDLE_STOP_MINUTES=30
# Persistent catalog paths normally do not need changing.
USER_CATALOG_PATH=/data/user-models.json
STATE_PATH=/data/state.json
PREFERENCES_PATH=/data/preferences.json

# Published runtime images (linux/amd64, tag 0.1.4). Digests are immutable.
RUNTIME_IMAGE_VLLM=ghcr.io/lightcr1/gpuharbor-runtime-vllm@sha256:47046f391746a94e442b238ad5b57d84d69c4854670858bed459e3cbc98254e4
RUNTIME_IMAGE_LLAMA_CPP=ghcr.io/lightcr1/gpuharbor-runtime-llama-cpp@sha256:83816656a93f6d6e959ce9c0e17352eb3c4d1fa665114eed6946453ce7b9e31e
RUNTIME_IMAGE_BONSAI=ghcr.io/lightcr1/gpuharbor-runtime-bonsai@sha256:d1ad005bc0f3a213be68b199665de35c3ce7c0c66a8af7c9fcc858fc94725662
HUGGINGFACE_TOKEN=

# Optional integrations
# Linux amd64 manifest for Open WebUI v0.11.4 (recheck before upgrades).
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui@sha256:332438e079ad23bb11b0ab278b43e7c98b50e8cec14b0840281644e8a289f49f
WEBUI_SECRET_KEY=replace-with-a-long-random-secret
# Linux amd64 manifest for OpenHands Agent Canvas 1.24.0.
OPENHANDS_IMAGE=ghcr.io/openhands/agent-canvas@sha256:65b9dd60572a8f489d157998637d9aa58ccbc454878eeef62152d67399e962ac
OPENHANDS_PROJECTS_PATH=./workspace
OPENHANDS_BACKEND_API_KEY=replace-with-a-separate-random-secret
HOST_BIND_IP=127.0.0.1
TLS_BIND_IP=127.0.0.1
TLS_PORT=8443
WEBUI_TLS_PORT=8444
OPENHANDS_TLS_PORT=8445
