ARG TORCH_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
FROM ${TORCH_IMAGE}
COPY requirements.diffusers.lock /tmp/requirements.diffusers.lock
RUN pip install --no-cache-dir --requirement /tmp/requirements.diffusers.lock
COPY gateway.py media_server.py /opt/gpuharbor/
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
ENTRYPOINT ["python3", "/opt/gpuharbor/gateway.py"]
