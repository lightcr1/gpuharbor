ARG VLLM_IMAGE=vllm/vllm-openai@sha256:082ca6f035279109041ffd3fe0695cb568b29bc580b35c4f297a66a08b216c1b
FROM ${VLLM_IMAGE}
COPY requirements.vllm.lock /tmp/requirements.vllm.lock
RUN pip install --no-cache-dir --requirement /tmp/requirements.vllm.lock
COPY gateway.py /opt/gpuharbor/gateway.py
EXPOSE 8000
ENTRYPOINT ["python3", "/opt/gpuharbor/gateway.py"]
