#!/usr/bin/env python3
"""Connect the PI coding agent to your GPUHarbor models.

Installs a small PI extension and a settings file (gpuharbor.json) into PI's agent
folder. The extension lists the models GPUHarbor is running right now as the provider
"gpuharbor" (each with its own name, so you can pick and switch in /model), and adds
/modelinfo. PI's models.json is not touched.

    ./scripts/connect-pi                 # install
    ./scripts/connect-pi --remove        # take it out again
    ./scripts/connect-pi --dry-run       # show what would be written
    ./scripts/connect-pi --url https://192.0.2.10:8443   # GPUHarbor on another machine
    ./scripts/connect-pi --token-from-env   # do not store the token; read it from .env per request

The token in gpuharbor.json is the model-only inference token (mode 600). It cannot
start, stop or delete pods. The model list is read when PI starts or reloads.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import ssl
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parents[1]
EXTENSION_SOURCE = ROOT / "pi-extension" / "gpuharbor.ts"
EXTENSION_MARKER = "Installed by ./scripts/connect-pi"
LEGACY_EXTENSION = "gpuharbor-modelinfo.ts"
SETTINGS = "gpuharbor.json"
LOCAL_CA = ROOT / "tls" / "local-ca.crt"
LOOPBACK = {"localhost", "127.0.0.1", "::1"}
# PI runs on this computer: the controller's loopback port needs no certificate.
# With HTTPS that port is bound to 127.0.0.1 only. Node does not trust GPUHarbor's local CA.
DEFAULT_URL = "http://127.0.0.1:8080"


def env_values(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.strip() and not line.lstrip().startswith("#") and "=" in line:
            key, _, value = line.partition("=")
            values[key.strip()] = value.strip().strip("'\"")
    return values


def agent_dir() -> Path:
    override = os.environ.get("PI_CODING_AGENT_DIR")
    return Path(override).expanduser() if override else Path.home() / ".pi" / "agent"


def fetch_running(url: str, token: str) -> dict:
    context = None
    if url.startswith("https://") and LOCAL_CA.exists():
        context = ssl.create_default_context(cafile=str(LOCAL_CA))
    request = urllib.request.Request(f"{url}/api/running-model", headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(request, timeout=15, context=context) as response:  # noqa: S310 - scheme checked
        return json.loads(response.read())


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temp = tempfile.mkstemp(dir=path.parent, prefix=".gpuharbor-", suffix=".tmp")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as file:
            file.write(text)
        os.chmod(temp, 0o600)
        os.replace(temp, path)
    except BaseException:
        Path(temp).unlink(missing_ok=True)
        raise


def is_ours(path: Path) -> bool:
    try:
        return EXTENSION_MARKER in path.read_text(encoding="utf-8").split("\n", 1)[0]
    except OSError:
        return False


def drop_legacy_provider(models_file: Path) -> bool:
    """Earlier versions wrote providers.gpuharbor into models.json; the extension replaces it."""
    try:
        data = json.loads(models_file.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    providers = data.get("providers") if isinstance(data, dict) else None
    if not isinstance(providers, dict) or "gpuharbor" not in providers:
        return False
    shutil.copy2(models_file, models_file.with_name(models_file.name + ".bak"))
    providers.pop("gpuharbor")
    write_atomic(models_file, json.dumps(data, indent=2) + "\n")
    return True


def check_reachable(url: str, token: str) -> str | None:
    """Return an error text, or None when GPUHarbor answers with this token."""
    try:
        fetch_running(url, token)
        return None
    except ssl.SSLError as error:
        return f"The HTTPS certificate is not trusted here: {error}\nRun ./scripts/trust-ca and try again."
    except urllib.error.HTTPError as error:
        if error.code == 401:
            return "GPUHarbor answered HTTP 401. The token in .env does not match the running controller; restart it."
        if error.code == 404:
            return "GPUHarbor answered HTTP 404. The running controller is older than this script. Update it: docker compose up -d --build controller"
        return f"GPUHarbor answered HTTP {error.code}."
    except (urllib.error.URLError, OSError, ValueError) as error:
        reason = getattr(error, "reason", error)
        if isinstance(reason, ssl.SSLError):
            return f"The HTTPS certificate is not trusted here: {reason}\nRun ./scripts/trust-ca and try again."
        return f"Cannot reach GPUHarbor at {url}: {reason}. Is it running? (./scripts/doctor)"


def main() -> int:
    parser = argparse.ArgumentParser(description="Connect the PI coding agent to GPUHarbor")
    parser.add_argument("--env", default=str(ROOT / ".env"), help="path to GPUHarbor's .env")
    parser.add_argument("--url", help=f"GPUHarbor address (default: {DEFAULT_URL})")
    parser.add_argument("--agent-dir", help="PI agent folder (default: ~/.pi/agent)")
    parser.add_argument("--token-from-env", action="store_true", help="do not store the token; PI reads it from .env on every request")
    parser.add_argument("--remove", action="store_true", help="remove the extension and settings again")
    parser.add_argument("--dry-run", action="store_true", help="print what would be written and change nothing")
    parser.add_argument("--print-token", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()

    env_path = Path(args.env)
    if not env_path.exists():
        print(f"{env_path} does not exist. Run ./scripts/install first.", file=sys.stderr)
        return 1
    token = env_values(env_path).get("MODEL_ACCESS_TOKEN", "")
    if args.print_token:
        sys.stdout.write(token)
        return 0 if token else 1

    agent = Path(args.agent_dir).expanduser() if args.agent_dir else agent_dir()
    extension = agent / "extensions" / EXTENSION_SOURCE.name
    settings = agent / SETTINGS
    legacy = agent / "extensions" / LEGACY_EXTENSION
    models_file = agent / "models.json"

    if args.remove:
        removed = []
        for path in (extension, legacy):
            if path.exists() and is_ours(path):
                path.unlink()
                removed.append(str(path))
        if settings.exists():
            settings.unlink()
            removed.append(str(settings))
        if drop_legacy_provider(models_file):
            removed.append(f"providers.gpuharbor in {models_file}")
        print("Removed: " + ", ".join(removed) if removed else "Nothing to remove.")
        return 0

    if not args.agent_dir and not (shutil.which("pi") or agent.exists()):
        print("PI was not found (no `pi` command and no ~/.pi/agent). Install PI first, then run this again.", file=sys.stderr)
        return 1
    if not token or "replace" in token or len(token) < 16:
        print("MODEL_ACCESS_TOKEN in .env is missing or a placeholder. Run ./scripts/init-env.", file=sys.stderr)
        return 1
    url = (args.url or DEFAULT_URL).rstrip("/")
    parsed = urlparse(url)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        print(f"Not a usable address: {url}", file=sys.stderr)
        return 1
    if parsed.scheme == "http" and parsed.hostname not in LOOPBACK:
        print(
            f"Refusing to send the token in plain HTTP to {parsed.hostname}. "
            "Use https:// (see docs/TLS.md), or a VPN address over https.",
            file=sys.stderr,
        )
        return 1
    if extension.exists() and not is_ours(extension):
        print(f"{extension} exists and was not made by this script. Move it away and run this again.", file=sys.stderr)
        return 1
    problem = check_reachable(url, token)
    if problem:
        print(problem, file=sys.stderr)
        return 1

    api_key = token
    if args.token_from_env:
        api_key = f"!{shlex.quote(sys.executable)} {shlex.quote(str(Path(__file__).resolve()))} --print-token --env {shlex.quote(str(env_path.resolve()))}"
    text = json.dumps({"url": url, "apiKey": api_key}, indent=2) + "\n"

    if args.dry_run:
        shown = text.replace(token, "<token>") if token in text else text
        print(f"Would write {settings}:\n{shown}Would install {extension}")
        return 0

    write_atomic(settings, text)
    extension.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(EXTENSION_SOURCE, extension)
    if legacy.exists() and is_ours(legacy):
        legacy.unlink()
    if drop_legacy_provider(models_file):
        print(f"Moved the old gpuharbor entry out of {models_file} (backup: {models_file.name}.bak).")
    print(f"Installed {extension} and {settings}.")
    print("Token: " + ("read from .env on every request." if args.token_from_env else "stored in that file (mode 600); run this script again after changing it."))
    print("PI shows the models GPUHarbor is running when it starts (or after /reload). Start a model, then pick it with /model.")
    if url.startswith("https://") and LOCAL_CA.exists():
        print(f"PI does not trust the local certificate by itself; start it with NODE_EXTRA_CA_CERTS={LOCAL_CA}")
    print("PI can run commands and change files: use it in a dedicated workspace.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
