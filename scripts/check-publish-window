#!/usr/bin/env python3
"""Block commits and pushes during the owner's regular working hours."""
from datetime import datetime
from zoneinfo import ZoneInfo
import sys

now = datetime.now(ZoneInfo("Europe/Zurich"))
blocked = now.weekday() < 5 and 7 <= now.hour < 18
if blocked:
    print(
        "GPUHarbor publication guard: commits and pushes are blocked Monday-Friday "
        "07:00-18:00 Europe/Zurich.",
        file=sys.stderr,
    )
    raise SystemExit(1)
print(f"GPUHarbor publication guard: allowed ({now:%A %Y-%m-%d %H:%M %Z}).")
