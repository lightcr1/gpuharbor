#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
python_bin=${PYTHON:-python3}

PYTHONPATH=. "$python_bin" -m pytest -q
"$python_bin" -m compileall -q gpuharbor runtime tests
"$python_bin" - <<'PY'
from pathlib import Path
import json
import re

for path in Path('.').rglob('*.json'):
    json.loads(path.read_text(encoding='utf-8'))
html = Path('gpuharbor/static/index.html').read_text(encoding='utf-8')
scripts = re.findall(r'<script src="/static/([^"]+\.js)"', html)
if not scripts:
    raise SystemExit('Dashboard JavaScript not found')
for name in scripts:
    if not Path('gpuharbor/static', name).exists():
        raise SystemExit(f'Dashboard script missing: {name}')
missing = []
markdown = sorted(path for path in Path('.').rglob('*.md') if '.git' not in path.parts)
for doc in markdown:
    for target in re.findall(r'\[[^]]+\]\(([^)]+)\)', doc.read_text(encoding='utf-8')):
        if '://' in target or target.startswith('#'):
            continue
        clean = target.split('#', 1)[0]
        if clean and not (doc.parent / clean).exists():
            missing.append((str(doc), target))
if missing:
    raise SystemExit(f'Missing documentation links: {missing}')
PY
for script in gpuharbor/static/*.js; do node --check "$script"; done
./scripts/check-compose

# ripgrep when available, plain grep otherwise, so the scans never silently do nothing.
search() {
  pattern=$1
  shift
  if command -v rg >/dev/null 2>&1; then
    rg -n --hidden --glob '!*.pyc' --glob '!__pycache__/**' --glob '!.git/**' \
      --glob '!.pytest_cache/**' --glob '!tls/**' "$@" -e "$pattern" .
  else
    grep -rInE --exclude-dir=.git --exclude-dir=tls --exclude-dir=.pytest_cache \
      --exclude-dir=__pycache__ --exclude='*.pyc' "$@" -e "$pattern" .
  fi
}

if search '(BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|rp_[A-Za-z0-9]{20,}|hf_[A-Za-z0-9]{20,})'; then
  echo 'Potential secret found.' >&2
  exit 1
fi
if search 'pod''deck|pod'' deck' -i; then
  echo 'Stale project name found.' >&2
  exit 1
fi
printf 'GPUHarbor local release checks passed.\n'
