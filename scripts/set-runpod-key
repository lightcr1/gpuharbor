#!/usr/bin/env python3
"""Set the RunPod API key in .env and optionally restart the controller.

Reads the key with a hidden prompt so it does not end up in your shell history,
validates the shape, and updates only the RUNPOD_API_KEY line.

    ./scripts/set-runpod-key
    ./scripts/set-runpod-key --no-restart
"""
from __future__ import annotations

import argparse
import getpass
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
KEY_PATTERN = re.compile(r"^rpa_[A-Za-z0-9]{20,}$")


def update_env(path: Path, value: str) -> None:
    lines = path.read_text(encoding="utf-8").splitlines()
    replaced = False
    output: list[str] = []
    for line in lines:
        if line.startswith("RUNPOD_API_KEY="):
            output.append(f"RUNPOD_API_KEY={value}")
            replaced = True
        else:
            output.append(line)
    if not replaced:
        output.append(f"RUNPOD_API_KEY={value}")
    path.write_text("\n".join(output) + "\n", encoding="utf-8")
    path.chmod(0o600)


def main() -> int:
    parser = argparse.ArgumentParser(description="Set the RunPod API key in .env")
    parser.add_argument("--env", default=str(ROOT / ".env"), help="path to .env")
    parser.add_argument("--key", help="provide the key directly (less safe: shell history)")
    parser.add_argument("--no-restart", action="store_true", help="do not recreate the controller")
    args = parser.parse_args()

    env_path = Path(args.env)
    if not env_path.exists():
        print(f"{env_path} does not exist. Run ./scripts/init-env first.", file=sys.stderr)
        return 1

    key = args.key or getpass.getpass("RunPod API key (input hidden): ")
    key = key.strip()
    if not KEY_PATTERN.fullmatch(key):
        print(
            "That does not look like a RunPod key. Expected a value starting with "
            "'rpa_' followed by letters and digits.",
            file=sys.stderr,
        )
        return 1

    update_env(env_path, key)
    print(f"Wrote RUNPOD_API_KEY to {env_path} (kept private).")

    if args.no_restart:
        print("Restart later with: docker compose up -d")
        return 0

    if subprocess.run(
        ["docker", "compose", "up", "-d"], cwd=ROOT, check=False
    ).returncode != 0:
        print("docker compose up failed; fix that, then run it again.", file=sys.stderr)
        return 1

    print("Controller restarted. Check it with: ./scripts/check-local-release")
    print("Then in the dashboard press 'Check availability' (free, read-only).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
