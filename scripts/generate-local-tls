#!/bin/sh
set -eu

host=${1:-localhost}
out=${2:-tls}
umask 077
mkdir -p "$out"

tmp=$(mktemp -d)
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT INT TERM

# Always valid for this machine; extra names (comma separated) are added.
san=""
for name in $(printf '%s,localhost,127.0.0.1,::1' "$host" | tr ',' ' '); do
  case " $san " in *"$name"*) continue ;; esac
  if printf '%s' "$name" | grep -Eq '^[0-9a-fA-F:.]+$'; then
    san="$san${san:+,}IP:$name"
  else
    san="$san${san:+,}DNS:$name"
  fi
done
first=${host%%,*}

# Keep the existing certificate (and the CA your devices already trust) while it is
# still valid for every requested name. Pass FORCE=1 to renew it anyway.
if [ "${FORCE:-0}" != 1 ] && [ -f "$out/server.crt" ] && [ -f "$out/local-ca.crt" ] \
   && openssl x509 -in "$out/server.crt" -noout -checkend 2592000 >/dev/null 2>&1; then
  covered=1
  for name in $(printf '%s,localhost,127.0.0.1,::1' "$host" | tr ',' ' '); do
    if printf '%s' "$name" | grep -Eq '^[0-9a-fA-F:.]+$'; then
      openssl x509 -in "$out/server.crt" -noout -checkip "$name" 2>/dev/null | grep -q "does match" || covered=0
    else
      openssl x509 -in "$out/server.crt" -noout -checkhost "$name" 2>/dev/null | grep -q "does match" || covered=0
    fi
  done
  if [ "$covered" = 1 ]; then
    printf 'Existing TLS certificate in %s is still valid for these names; keeping it (FORCE=1 renews).\n' "$out"
    exit 0
  fi
fi

cat >"$tmp/server.cnf" <<EOF
[req]
distinguished_name = dn
prompt = no
req_extensions = req_ext
[dn]
CN = $first
[req_ext]
subjectAltName = $san
extendedKeyUsage = serverAuth
keyUsage = digitalSignature,keyEncipherment
EOF

openssl req -x509 -newkey rsa:3072 -sha256 -nodes \
  -keyout "$out/local-ca.key" -out "$out/local-ca.crt" -days 3650 \
  -subj "/CN=GPUHarbor Local CA" >/dev/null 2>&1
openssl req -new -newkey rsa:3072 -nodes -sha256 \
  -keyout "$out/server.key" -out "$tmp/server.csr" \
  -config "$tmp/server.cnf" >/dev/null 2>&1
openssl x509 -req -sha256 -days 825 \
  -in "$tmp/server.csr" -CA "$out/local-ca.crt" -CAkey "$out/local-ca.key" \
  -CAcreateserial -out "$out/server.crt" \
  -extfile "$tmp/server.cnf" -extensions req_ext >/dev/null 2>&1
# The CA key is only needed to sign the server certificate. Removing it means a
# leaked tls/ folder cannot mint certificates that your devices trust.
rm -f "$out/local-ca.key" "$out/local-ca.srl"
chmod 600 "$out"/*.key
chmod 644 "$out"/*.crt
printf 'Created local TLS certificate for %s in %s. Trust only %s/local-ca.crt on your clients.\n' "$san" "$out" "$out"
