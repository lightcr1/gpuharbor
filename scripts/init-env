#!/usr/bin/env python3
"""Create a local .env from .env.example without fragile in-place edits.

Generates independent random secrets for every placeholder and optionally sets
the bind address and trusted hosts. Existing real values are preserved; running
the script again never overwrites secrets that no longer contain "replace".
"""
from __future__ import annotations

import argparse
import secrets
import shutil
import sys
from pathlib import Path

SECRET_KEYS = [
    "RUNPOD_API_KEY",
    "CONTROL_TOKEN",
    "MODEL_ACCESS_TOKEN",
    "RUNTIME_GATEWAY_TOKEN",
    "GPUHARBOR_ADMIN_PASSWORD",
    "GPUHARBOR_SESSION_SECRET",
    "WEBUI_SECRET_KEY",
    "OPENHANDS_BACKEND_API_KEY",
]


def parse(text: str) -> tuple[list[str], dict[str, str]]:
    lines = text.splitlines()
    values: dict[str, str] = {}
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        values[key.strip()] = value
    return lines, values


def render(lines: list[str], updates: dict[str, str]) -> str:
    seen: set[str] = set()
    output: list[str] = []
    for line in lines:
        stripped = line.strip()
        if stripped and not stripped.startswith("#") and "=" in line:
            key = line.partition("=")[0].strip()
            if key in updates:
                output.append(f"{key}={updates[key]}")
                seen.add(key)
                continue
        output.append(line)
    for key, value in updates.items():
        if key not in seen:
            output.append(f"{key}={value}")
    return "\n".join(output) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description="Initialise a GPUHarbor .env")
    parser.add_argument("--env", default=".env", help="target file (default: .env)")
    parser.add_argument("--example", default=".env.example", help="template file")
    parser.add_argument("--bind-ip", help="set HOST_BIND_IP, e.g. 0.0.0.0 or 192.0.2.10")
    parser.add_argument(
        "--trusted-hosts",
        help="comma separated GPUHARBOR_TRUSTED_HOSTS value; defaults to localhost plus the bind/https hosts",
    )
    parser.add_argument(
        "--add-trusted-host",
        action="append",
        default=[],
        metavar="ADDRESS",
        help="append an address to GPUHARBOR_TRUSTED_HOSTS without removing existing ones (repeatable)",
    )
    parser.add_argument(
        "--https-host",
        help="host used for the TLS proxy; sets TLS_BIND_IP and GPUHARBOR_COOKIE_SECURE=true",
    )
    parser.add_argument("--tls-port", help="host port for the TLS proxy (default 8443)")
    parser.add_argument(
        "--reset-password",
        action="store_true",
        help="generate a new admin password, keep every other value, and print it",
    )
    parser.add_argument(
        "--show-login",
        action="store_true",
        help="print the admin user name and password from the .env and exit",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="regenerate every secret even if a real value is already present",
    )
    args = parser.parse_args()

    target = Path(args.env)
    example = Path(args.example)
    if not example.exists():
        print(f"Template {example} not found.", file=sys.stderr)
        return 1

    if args.show_login:
        if not target.exists():
            print(f"{target} does not exist yet. Run ./scripts/init-env first.", file=sys.stderr)
            return 1
        _, current = parse(target.read_text(encoding="utf-8"))
        print(f"User    : {current.get('GPUHARBOR_ADMIN_USERNAME', 'admin') or 'admin'}")
        print(f"Password: {current.get('GPUHARBOR_ADMIN_PASSWORD', '')}")
        return 0

    source = target if target.exists() else example
    lines, values = parse(source.read_text(encoding="utf-8"))

    updates: dict[str, str] = {}
    for key in SECRET_KEYS:
        current = values.get(key, "")
        if args.force or not current or "replace" in current.lower():
            updates[key] = secrets.token_hex(32)

    if args.reset_password:
        updates["GPUHARBOR_ADMIN_PASSWORD"] = secrets.token_urlsafe(18)

    if args.bind_ip:
        updates["HOST_BIND_IP"] = args.bind_ip
    if args.https_host:
        updates["TLS_BIND_IP"] = args.https_host
        updates["GPUHARBOR_COOKIE_SECURE"] = "true"
    if args.tls_port:
        updates["TLS_PORT"] = args.tls_port

    existing = [part.strip() for part in values.get("GPUHARBOR_TRUSTED_HOSTS", "").split(",") if part.strip()]
    hosts = list(dict.fromkeys(existing)) or ["localhost", "127.0.0.1"]
    for candidate in (args.bind_ip, args.https_host):
        if candidate and candidate not in hosts:
            hosts.append(candidate)
    for value in args.add_trusted_host:
        for part in value.split(","):
            part = part.strip()
            if part and part not in hosts:
                hosts.append(part)
    if args.trusted_hosts:
        hosts = [part.strip() for part in args.trusted_hosts.split(",") if part.strip()]
    if args.bind_ip or args.https_host or args.trusted_hosts or args.add_trusted_host:
        updates["GPUHARBOR_TRUSTED_HOSTS"] = ",".join(hosts)

    if target.exists():
        backup = target.with_suffix(target.suffix + ".bak")
        shutil.copy2(target, backup)
        print(f"Backup written to {backup}")

    target.write_text(render(lines, updates), encoding="utf-8")
    target.chmod(0o600)
    changed = ", ".join(sorted(updates)) or "nothing"
    print(f"Wrote {target}. Updated: {changed}")
    if args.reset_password:
        print(f"New admin password: {updates['GPUHARBOR_ADMIN_PASSWORD']}")
        print("Restart the controller to apply it: docker compose up -d")
    print("Keep RUNPOD_ALLOW_BILLABLE_ACTIONS=false until you intend to spend money.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
