#!/usr/bin/env python3
"""Interactive GPUHarbor setup assistant.

Asks a few questions, writes .env, optionally creates TLS certificates and
starts exactly the services you tick. Every answer can also be given as a flag,
so it works unattended.

Examples:
    ./scripts/setup
    ./scripts/setup --yes
    ./scripts/setup --bind 0.0.0.0 --https 192.0.2.10 --https-port 9443 --webui --start
    ./scripts/setup --no-https               # plain HTTP on localhost
    ./scripts/setup --dry-run --bind 192.0.2.10 --https 192.0.2.10
"""
from __future__ import annotations

import argparse
import ipaddress
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def ask(question: str, default: str = "") -> str:
    suffix = f" [{default}]" if default else ""
    try:
        answer = input(f"{question}{suffix}: ").strip()
    except EOFError:
        answer = ""
    return answer or default


def ask_bool(question: str, default: bool = False) -> bool:
    default_text = "J" if default else "n"
    answer = ask(f"{question} (j/n)", default_text).lower()
    return answer.startswith("j") or answer.startswith("y")


def valid_host(value: str) -> bool:
    if not value:
        return False
    try:
        ipaddress.ip_address(value)
        return True
    except ValueError:
        return "." in value and " " not in value


def run(command: list[str], *, dry_run: bool) -> None:
    print("+", " ".join(command))
    if not dry_run:
        subprocess.run(command, cwd=ROOT, check=True)


def main() -> int:
    parser = argparse.ArgumentParser(description="Interactive GPUHarbor setup")
    parser.add_argument("--yes", action="store_true", help="accept every default")
    parser.add_argument("--bind", help="bind address (127.0.0.1, 0.0.0.0 or a LAN/VPN IP)")
    parser.add_argument("--https", metavar="HOST", help="enable HTTPS for this host")
    parser.add_argument("--no-https", action="store_true", help="serve plain HTTP on localhost instead of HTTPS")
    parser.add_argument("--https-port", default="8443", help="host port for the HTTPS proxy")
    parser.add_argument("--webui", action="store_true", help="include Open WebUI")
    parser.add_argument("--openhands", action="store_true", help="include OpenHands Agent Canvas")
    parser.add_argument("--pi", action="store_true", help="connect the PI coding agent")
    parser.add_argument("--start", action="store_true", help="start the stack after setup")
    parser.add_argument("--dry-run", action="store_true", help="print the commands without running them")
    args = parser.parse_args()

    interactive = not args.yes and not args.dry_run
    print("GPUHarbor Setup\n" + "-" * 40)

    bind = args.bind
    if not bind:
        bind = ask("Bind-Adresse (127.0.0.1 = nur lokal, 0.0.0.0 = alle, oder LAN/VPN-IP)", "127.0.0.1") if interactive else "127.0.0.1"
    if not valid_host(bind):
        print(f"Ungültige Bind-Adresse: {bind}", file=sys.stderr)
        return 1

    https_host = None if args.no_https else args.https
    if https_host is None and not args.no_https:
        if interactive:
            if ask_bool("HTTPS verwenden? (empfohlen)", True):
                https_host = ask("Hostname oder IP für das Zertifikat",
                                 "127.0.0.1" if bind in {"127.0.0.1", "0.0.0.0"} else bind)
        else:
            https_host = "127.0.0.1" if bind in {"127.0.0.1", "0.0.0.0"} else bind
    if https_host and not valid_host(https_host):
        print(f"Ungültiger HTTPS-Host: {https_host}", file=sys.stderr)
        return 1

    webui = args.webui
    openhands = args.openhands
    pi = args.pi
    if interactive:
        webui = ask_bool("Open WebUI mitinstallieren?", webui)
        openhands = ask_bool("OpenHands mitinstallieren? (führt Code aus)", openhands)
        pi = ask_bool("PI Coding Agent (auf diesem Rechner) mit den Modellen verbinden?", pi)

    start = args.start
    if interactive and not start:
        start = ask_bool("Jetzt starten?", True)

    print("-" * 40)
    print(f"Bind-Adresse : {bind}")
    print(f"HTTPS        : {https_host or 'nein'}" + (f" (Port {args.https_port})" if https_host else ""))
    print(f"Open WebUI   : {'ja' if webui else 'nein'}")
    print(f"OpenHands    : {'ja' if openhands else 'nein'}")
    print(f"PI Agent     : {'ja' if pi else 'nein'}")
    print(f"Starten      : {'ja' if start else 'nein'}")
    print("-" * 40)

    if interactive and not ask_bool("So fortfahren?", True):
        print("Abgebrochen.")
        return 1

    # The installer does the real work, so both entry points behave the same.
    command = [sys.executable, "scripts/install", "--bind-ip", bind, "--tls-port", args.https_port]
    command += ["--https", https_host] if https_host else ["--no-https"]
    if webui:
        command.append("--webui")
    if openhands:
        command.append("--openhands")
    if pi:
        command.append("--pi")
    if not start:
        command.append("--no-start")
    if args.dry_run:
        command.append("--dry-run")
    print("+", " ".join(command))
    return subprocess.run(command, cwd=ROOT, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
